# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — used by OpenRouter for ranking/attribution. Defaults below are fine.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Storista

# Optional — override the model. Default is google/gemini-2.5-flash.
# Other options: google/gemini-2.5-pro, openai/gpt-4o-mini, anthropic/claude-haiku-4.5
# OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Lumen Pro (image generation, optional) -------------------------------
# Bearer token from https://app.lumenpro.io — without it, stories are text-only.
# LUMEN_TOKEN=

# Optional — model & aspect ratio for cover images.
# Default model is 19 (imagen-4, 6 credits, no input image required).
# LUMEN_MODEL_ID=19
# LUMEN_ASPECT_RATIO=16:9
