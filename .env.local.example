# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — used by OpenRouter for ranking/attribution. Defaults below are fine.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Storista

# Optional — override the model. Default is google/gemini-2.5-flash.
# Other options: google/gemini-2.5-pro, openai/gpt-4o-mini, anthropic/claude-haiku-4.5
# OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Image generation -----------------------------------------------------
# Which provider to use for per-page illustrations.
# openrouter (default) — uses OPENROUTER_API_KEY above; cheapest, single vendor.
# lumen — uses Lumen Pro MCP (requires LUMEN_TOKEN below).
# none — text-only stories, no images.
# IMAGE_PROVIDER=openrouter

# Default OpenRouter image model. Override if you want a different one.
# Cheap & fast: google/gemini-2.5-flash-image (Nano Banana)
# Higher quality: google/gemini-3-pro-image-preview, openai/gpt-5-image
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# --- Lumen Pro (only if IMAGE_PROVIDER=lumen) -----------------------------
# Bearer token from https://app.lumenpro.io
# LUMEN_TOKEN=
# LUMEN_MODEL_ID=19
# LUMEN_ASPECT_RATIO=16:9
