# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — used by OpenRouter for ranking/attribution. Defaults below are fine.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Storista

# Optional — override the model. Default is google/gemma-4-31b-it:free (free tier).
# Paid options for higher quality: google/gemini-2.5-flash, anthropic/claude-haiku-4.5
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- Image generation -----------------------------------------------------
# Which provider to use for per-page illustrations.
# openrouter (default) — google/gemini-2.5-flash-image. Requires paid credits
#   on OpenRouter (no :free image models exist). ~$0.001 per image.
# lumen — Lumen Pro MCP (requires LUMEN_TOKEN below).
# none — text-only stories, no images.
# IMAGE_PROVIDER=openrouter

# Only used when IMAGE_PROVIDER=openrouter. Default: google/gemini-2.5-flash-image (Nano Banana).
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# --- Lumen Pro (only if IMAGE_PROVIDER=lumen) -----------------------------
# Bearer token from https://app.lumenpro.io
# LUMEN_TOKEN=
# LUMEN_MODEL_ID=19
# LUMEN_ASPECT_RATIO=16:9
